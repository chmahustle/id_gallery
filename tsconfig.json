{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/components/ui/**/*",
    "src/lib/cn.ts",
    "src/lib/tokens.ts",
    "src/pages/DevUi.tsx",
    "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "server", "src/**/*.test.ts"]
}
