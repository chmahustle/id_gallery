{
  "name": "id-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node --import tsx server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.data.json",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "check:images": "node --import tsx scripts/check-images.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "^18.4.0-beta.17",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
