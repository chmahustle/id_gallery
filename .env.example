# Локально без системного PostgreSQL (встроенный на порту 54329):
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54329/id_gallery
# Или свой PostgreSQL:
# DATABASE_URL=postgresql:///id_gallery?host=/var/run/postgresql

PORT=3001

# Админка: один администратор, логин и пароль только здесь (не VITE_*).
# Пароль — не короче 12 символов, не из примера; иначе вход отключён.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Демо-товары (src/data/demoProducts.ts): true — показывать, пусто/false — скрыть
VITE_DEMO_DATA=true
