# Локально без системного PostgreSQL (встроенный на порту 54329):
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54329/id_gallery
# Или свой PostgreSQL:
# DATABASE_URL=postgresql:///id_gallery?host=/var/run/postgresql

PORT=3001

# Админка — только на сервере (не VITE_*)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Демо-товары (src/data/demoProducts.ts): true — показывать, пусто/false — скрыть
VITE_DEMO_DATA=true
