# Скопируйте в .env.docker и задайте свои значения (файл не коммитится)
POSTGRES_PASSWORD=смените-пароль-базы
# Админка: один администратор. Пароль — не короче 12 символов, иначе вход отключён.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Порт сайта на сервере: http://адрес:8080
APP_PORT=8080

# Демо-товары и заглушки для показа заказчику (true / false). Меняется при сборке.
VITE_DEMO_DATA=true

# 1 — только когда сайт открывается по HTTPS (домен + сертификат)
COOKIE_SECURE=0
# 1 — если перед сайтом стоит nginx / прокси
TRUST_PROXY=0
